/*
 * Miryoku-style keymap for the REVIUNG41 (41 keys)
 *
 * Ported from Manna Harbour's Miryoku (https://github.com/manna-harbour/miryoku)
 * with the NUM and SYM layers mirrored to the right hand (Miryoku's "flip"):
 * the numpad and the symbols both live under the right hand while the left
 * hand holds modifiers for chording.
 *
 * Physical layout, 12 / 12 / 12 / 5:
 *
 *   TAB    Q    W    E    R    T  |  Y    U    I    O    P   BSPC
 *   LCTRL  A    S    D    F    G  |  H    J    K    L    ;   '
 *   LSHFT  Z    X    C    V    B  |  N    M    ,    .    /   RSHFT
 *                    NAV  NUM  SYM  FUN  MEDIA
 *
 * Hold a thumb key for its layer, tap it for the key underneath:
 *   NAV/SPACE  NUM/BSPC  SYM/RET  FUN/DEL  MEDIA/ESC
 *
 * Layers: 0 base, 1 nav, 2 num, 3 sym, 4 fun, 5 media
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define L_BASE  0
#define L_NAV   1
#define L_NUM   2
#define L_SYM   3
#define L_FUN   4
#define L_MEDIA 5

/* Miryoku clipboard helpers. Ctrl-based for Linux/Windows;
   swap LC( for LG( if you drive this board from macOS. */
#define U_UND &kp LC(Z)
#define U_CUT &kp LC(X)
#define U_CPY &kp LC(C)
#define U_PST &kp LC(V)
#define U_RDO &kp LC(LS(Z))

/ {
    behaviors {
        /* Miryoku home row mod: hold for the modifier, tap for the key */
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Miryoku thumb key: hold for the layer, tap for the key */
        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
    &kp TAB       &kp Q          &kp W          &kp E           &kp R          &kp T           &kp Y          &kp U            &kp I           &kp O          &kp P           &kp BSPC
    &kp LCTRL     &u_mt LGUI A   &u_mt LALT S   &u_mt LCTRL D   &u_mt LSHFT F  &kp G           &kp H          &u_mt LSHFT J    &u_mt LCTRL K   &u_mt LALT L   &u_mt LGUI SEMI &kp SQT
    &kp LSHFT     &kp Z          &kp X          &kp C           &kp V          &kp B           &kp N          &kp M            &kp COMMA       &kp DOT        &kp FSLH        &kp RSHFT
                                                        &u_lt L_NAV SPACE   &u_lt L_NUM BSPC   &u_lt L_SYM RET   &u_lt L_FUN DEL   &u_lt L_MEDIA ESC
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
    &trans        &trans         &trans         &trans          &trans         &trans          U_RDO          U_PST            U_CPY           U_CUT          U_UND           &trans
    &trans        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT      &trans          &caps_word     &kp LEFT         &kp DOWN        &kp UP         &kp RIGHT       &trans
    &trans        &trans         &trans         &trans          &trans         &trans          &kp INS        &kp HOME         &kp PG_DN       &kp PG_UP      &kp END         &trans
                                                        &trans              &trans              &kp RET           &kp BSPC          &kp DEL
            >;
        };

        num {
            display-name = "Num";
            bindings = <
    &trans        &trans         &trans         &trans          &trans         &trans          &kp LBKT       &kp N7           &kp N8          &kp N9         &kp RBKT        &trans
    &trans        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT      &trans          &kp EQUAL      &kp N4           &kp N5          &kp N6         &kp SEMI        &trans
    &trans        &trans         &trans         &trans          &trans         &trans          &kp BSLH       &kp N1           &kp N2          &kp N3         &kp GRAVE       &trans
                                                        &trans              &trans              &kp MINUS         &kp N0            &kp DOT
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
    &trans        &trans         &trans         &trans          &trans         &trans          &kp LBRC       &kp AMPS         &kp ASTRK       &kp LPAR       &kp RBRC        &trans
    &trans        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT      &trans          &kp PLUS       &kp DLLR         &kp PRCNT       &kp CARET      &kp COLON       &trans
    &trans        &trans         &trans         &trans          &trans         &trans          &kp PIPE       &kp EXCL         &kp AT          &kp HASH       &kp TILDE       &trans
                                                        &trans              &trans              &kp UNDER         &kp LPAR          &kp RPAR
            >;
        };

        fun {
            display-name = "Fun";
            bindings = <
    &trans        &kp F12        &kp F7         &kp F8          &kp F9         &kp PSCRN       &trans         &trans           &trans          &trans         &trans          &trans
    &trans        &kp F11        &kp F4         &kp F5          &kp F6         &kp SLCK        &trans         &trans           &trans          &trans         &trans          &trans
    &trans        &kp F10        &kp F1         &kp F2          &kp F3         &kp K_APP       &trans         &trans           &trans          &trans         &trans          &trans
                                                        &trans              &trans              &trans            &trans            &trans
            >;
        };

        media {
            display-name = "Media";
            bindings = <
    &bootloader   &trans         &trans         &trans          &trans         &trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI &rgb_ug RGB_SAI  &rgb_ug RGB_BRI &trans
    &trans        &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT      &trans          &kp C_PREV       &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT       &kp C_MUTE      &trans
    &trans        &trans         &trans         &trans          &trans         &trans          &out OUT_TOG     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3    &trans
                                                        &trans              &trans              &kp C_STOP        &kp C_PP          &trans
            >;
        };
    };
};
